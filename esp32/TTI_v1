// -----------------------------------------------------------------------------
// SETUP
// -----------------------------------------------------------------------------
void setup() {
    Serial.begin(115200);
    delay(1000);

    // Hardware initializations
    np.begin();
    np.clear();
    np.show();
    ds_sensor.begin();

    // Mount LittleFS filesystem on flash
    if (!LittleFS.begin(true)) {
        Serial.println("LittleFS Mount Failed!");
        return;
    }

    reset_and_init_log();

    Serial.println("Starting System...");
    Serial.printf("%-8s | %-10s | %-14s | %s\n", "Time (h)", "Temp (°C)", "Pop (CFU/mL)", "Status");
    Serial.println("----------------------------------------------------");
}

// -----------------------------------------------------------------------------
// MAIN LOOP
// -----------------------------------------------------------------------------
void loop() {
    float temp = read_temperature();

    // 1. Ratkowsky Growth Rate
    float mu_max = (temp > T_MIN) ? std::pow(B_RATKOWSKY * (temp - T_MIN), 2) : 0.0f;

    // 2. Baranyi Sharp-J Logic
    float alpha_t = A_state / (1.0f + A_state);
    float f_t = 1.0f - std::exp(y_t - Y_MAX);

    // 3. Differential Step Integration
    y_t += (mu_max * alpha_t * f_t * DT_HOURS);

    // 4. Update Physiological Adaptation State
    A_state += (mu_max * A_state * DT_HOURS);

    float pop_actual = std::exp(y_t);
    const char* status;

    // LED Status Logic
    if (y_t >= CRIT_LN) {
        status = "RED";
    } else if (y_t >= WARN_LN) {
        status = "YELLOW";
    } else {
        status = "GREEN";
    }

    // Output & Log
    log_data(elapsed_hours, temp, pop_actual, status);
    Serial.printf("%-8.2f | %-10.1f | %-14.0f | %s\n", elapsed_hours, temp, pop_actual, status);

    // Hook for future IoT messaging
    send_iot_telemetry(temp, pop_actual, status);

    // Play visual pattern (blocking 8.0 seconds)
    display_accessible_alert(y_t);

    elapsed_hours += DT_HOURS;
}
